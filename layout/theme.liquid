<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <meta name="robots" content="noindex">
    <title>{{ page_title }}</title>

    {{ content_for_header }}

    {%- assign should_redirect = template != blank -%}

    {%- if settings.storefront_hostname != blank and should_redirect -%}
      <link rel="canonical" href="https://{{ settings.storefront_hostname }}{{ request.path }}">
    {% else %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}

    {%- if settings.storefront_hostname != blank and should_redirect -%}
      <script>
        function getCookie(name) {
          name = name + "=";
          var decodedCookie = decodeURIComponent(document.cookie);
          var cookies = decodedCookie.split(";");
          for (var i = 0; i < cookies.length; i++) {
            var cookie = cookies[i].trim();
            if (cookie.indexOf(name) == 0) return cookie.substring(name.length, cookie.length);
          }
        }

        if (!window.Shopify.designMode && 
            window.location.pathname !== "/checkpoint" && 
            window.location.pathname !== "/throttle/queue" && 
            window.location.pathname !== "/challenge") {
          var storefrontHostname = "{{ settings.storefront_hostname }}";
          var currentHostname = window.location.hostname;

          if (currentHostname !== storefrontHostname) {
            var redirectUrl = new URL(window.location.href.replace(currentHostname, storefrontHostname));
            
            {%- if settings.integrate_with_customer_accounts and customer != null -%}
              redirectUrl.searchParams.append("logged_in", "true");
            {%- endif -%}

            var discountCode = getCookie("discount_code");
            if (discountCode) redirectUrl.searchParams.append("discount", discountCode);
            
            window.storefrontRedirectUrl = redirectUrl.toString();
            window.location.replace(redirectUrl);
          }
        }
      </script>
    {%- endif -%}

    <style>
      :root {
        --bg: #FDFCFB;
        --fg: #1E030E;
        --accent: #B8285A;
        --border: rgba(30, 3, 14, 0.1);
      }

      @import url("https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;1,400\&family=Raleway:wght@400;500\&display=swap");

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Raleway", sans-serif;
        background-color: var(--bg);
        color: var(--fg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      .theme-header {
        padding: 40px 60px;
        border-bottom: 1px solid var(--border);
      }

      .brand-name {
        font-family: "EB Garamond", serif;
        font-size: 20px;
        letter-spacing: 0.05em;
        text-transform: none;
      }

      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
      }

      .redirect-content {
        text-align: center;
        max-width: 600px;
      }

      .redirect-title {
        font-family: "EB Garamond", serif;
        font-style: italic;
        font-size: clamp(32px, 8vw, 64px);
        margin: 0 0 40px 0;
        font-weight: 400;
      }

      .divider {
        width: 80px;
        height: 1px;
        background-color: var(--accent);
        margin: 0 auto 40px auto;
        opacity: 0.6;
      }

      .redirect-link {
        color: var(--accent);
        text-decoration: none;
        font-size: 14px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(184, 40, 90, 0.2);
        padding-bottom: 4px;
        transition: all 0.3s ease;
      }

      .redirect-link:hover {
        border-bottom-color: var(--accent);
        opacity: 0.8;
      }

      .discovery-tag {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 20px;
        display: block;
      }

      @media (max-width: 768px) {
        .theme-header { padding: 30px 20px; text-align: center; }
      }
    </style>
  </head>
  <body>
    <header class="theme-header">
      <div class="brand-name">Relics & Reverie</div>
    </header>

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    <script>
      if (!window.Shopify.designMode && window.storefrontRedirectUrl) {
        var link = document.getElementById("redirect-link");
        if (link) link.href = window.storefrontRedirectUrl;
      }
    </script>
  </body>
</html>
